# 网页版可以直接在「设置」里填 Key，会自动生成 .env，不用手动复制本文件。
# 只用命令行的话：复制本文件为 .env，然后填入你的 Key（.env 不要提交到 git）
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://你的中转地址   # 使用代理/中转时填写

# 以下都是可选项，不写就用默认值（见 rag/config.py）
# CLAUDE_MODEL=claude-opus-5-5
# EFFORT=low                 # low / medium / high
# EMBEDDER=bge               # bge（语义向量）/ tfidf（手写关键词向量）
# CHUNK_SIZE=200
# CHUNK_OVERLAP=40
# TOP_K=4
# MIN_SCORE_BGE=0.35
# QUERY_REWRITE=1            # 多轮对话时改写追问
# USE_FALLBACKS=1            # 通过代理/中转访问 API 报错时改成 0

# 国内下载 HuggingFace 模型慢的话，打开下面这行用镜像
# HF_ENDPOINT=https://hf-mirror.com
